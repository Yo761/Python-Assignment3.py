def factorial(n):
    # Check for negative number
    if n < 0:
        return "Factorial is not defined for negative numbers"
    
    result = 1
    for i in range(1, n + 1):
        result *= i
    return result


# Main program
num = int(input("Enter a number: "))
fact = factorial(num)
print(f"Factorial of {num} is: {fact}")
